generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SavedAddress {
  id          String   @id @default(cuid())
  phone       String
  country     String
  street      String
  apt         String?
  city        String
  state       String
  zip         String
  fullAddress String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phone])
}

model VerificationCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

model User {
  id           String        @id @default(cuid())
  googleId     String?       @unique
  email        String        @unique
  firstName    String?
  lastName     String?
  name         String
  password     String?
  image        String?
  phone        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  savedStores  SavedStore[]
  paymentCards PaymentCard[]

  @@index([email])
}

model SavedStore {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  placeId   String
  name      String
  address   String
  lat       Float?
  lng       Float?
  storeData Json
  createdAt DateTime @default(now())

  @@unique([userId, placeId])
  @@index([userId])
}

model PaymentCard {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  last4        String
  brand        String
  expMonth     Int
  expYear      Int
  nameOnCard   String
  securityCode String?
  createdAt    DateTime @default(now())

  @@index([userId])
}